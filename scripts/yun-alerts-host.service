[Unit]
Description=Yún crash alert listener
After=graphical-session.target network.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'set -a; . "%h/.config/arduino-tailscaled.env"; set +a; exec "$YUN_ALERTS_SCRIPT"'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
