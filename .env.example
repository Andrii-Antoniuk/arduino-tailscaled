# Copy to .env and fill in your machines. .env is gitignored.

# LAN addresses (use IPs; NFS exports cannot take hostnames)
HOST_LAN_IP=192.168.1.10
YUN_HOST=192.168.1.20
YUN_USER=root

# Crash notes from the Yun to this PC
ALERT_LISTEN_PORT=7422
EXPORT_DIR=/srv/yun-tailscale-test

# Yun paths
YUN_USB=/mnt/tailscale-usb
YUN_NFS_MOUNT=/mnt/yun-tailscale-test
NFS_EXPORT_FILE=/etc/exports.d/yun-tailscale-test.exports
OWNER_UID=1000
OWNER_GID=1000

# Tailnet node name for new bridge builds (existing binaries keep their baked name)
TS_HOSTNAME=yun
NOTIFY_APP=yun-bridge

# Wake-on-LAN from the Yun
WOL_IFACE=eth0
WOL_MAC=00:00:00:00:00:00

# systemd ExecStart for scripts/yun-alerts-host.service
YUN_ALERTS_SCRIPT=/absolute/path/to/arduino-tailscaled/scripts/watch-yun-alerts-host.sh
